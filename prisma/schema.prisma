// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Admin {
  id           String    @id @default(cuid()) @db.VarChar(191)
  email        String    @unique @db.VarChar(191)
  passwordHash String    @db.VarChar(255)
  createdAt    DateTime  @default(now()) @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @db.DateTime(3)
  projects     Project[]
}

model Technology {
  id       String              @id @default(cuid()) @db.VarChar(191)
  name     String              @unique @db.VarChar(100)
  slug     String              @unique @db.VarChar(120)
  logoUrl  String?             @db.VarChar(500)
  createdAt DateTime           @default(now()) @db.DateTime(3)
  updatedAt DateTime           @updatedAt @db.DateTime(3)
  projects ProjectTechnology[]
}

model Project {
  id                        String    @id @default(cuid()) @db.VarChar(191)
  adminId                   String?   @db.VarChar(191)
  admin                     Admin?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  title                     String    @db.VarChar(255)
  slug                      String    @unique @db.VarChar(255)
  year                      Int?      @db.SmallInt
  shortDescription          String    @db.Text
  context                   String    @db.LongText
  objectives                Json
  technicalStackDescription String    @db.LongText
  developedSkills           Json
  results                   Json
  improvements              Json?
  seoTitle                  String    @db.VarChar(255)
  seoDescription            String    @db.VarChar(500)
  canonicalUrl              String?   @db.VarChar(500)
  ogImageUrl                String?   @db.VarChar(500)
  githubUrl                 String?   @db.VarChar(500)
  demoUrl                   String?   @db.VarChar(500)
  videoUrl                  String?   @db.VarChar(500)
  heroImageUrl              String    @db.VarChar(500)
  heroImageAlt              String    @db.VarChar(255)
  isPublished               Boolean   @default(false)
  publishedAt               DateTime? @db.DateTime(3)
  createdAt                 DateTime  @default(now()) @db.DateTime(3)
  updatedAt                 DateTime  @updatedAt @db.DateTime(3)
  images                    ProjectImage[]
  technologies              ProjectTechnology[]

  @@index([isPublished])
  @@index([publishedAt])
  @@index([createdAt])
}

model ProjectTechnology {
  projectId    String     @db.VarChar(191)
  technologyId String     @db.VarChar(191)
  createdAt    DateTime   @default(now()) @db.DateTime(3)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  technology   Technology @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([projectId, technologyId])
  @@index([projectId])
  @@index([technologyId])
}

model ProjectImage {
  id           String   @id @default(cuid()) @db.VarChar(191)
  projectId    String   @db.VarChar(191)
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl     String   @db.VarChar(500)
  altText      String   @db.VarChar(255)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  @@index([projectId])
  @@index([projectId, displayOrder])
}

model User {
  id            String    @id @db.VarChar(191)
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(191)
  emailVerified Boolean   @default(false)
  image         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now()) @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @db.DateTime(3)
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @db.VarChar(191)
  expiresAt DateTime @db.DateTime(3)
  token     String   @unique @db.VarChar(255)
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)
  ipAddress String?  @db.VarChar(255)
  userAgent String?  @db.Text
  userId    String   @db.VarChar(191)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.VarChar(191)
  accountId             String    @db.VarChar(255)
  providerId            String    @db.VarChar(255)
  userId                String    @db.VarChar(191)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @db.DateTime(3)
  scope                 String?   @db.Text
  password              String?   @db.VarChar(255)
  createdAt             DateTime  @default(now()) @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @db.DateTime(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.VarChar(191)
  identifier String   @db.VarChar(255)
  value      String   @db.Text
  expiresAt  DateTime @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)
  updatedAt  DateTime @updatedAt @db.DateTime(3)

  @@index([identifier])
  @@map("verification")
}
